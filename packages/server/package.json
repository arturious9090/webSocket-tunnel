{
  "name": "@arturious/web-socket-tunnel-server",
  "version": "1.0.1",
  "description": "Public tunnel server with automatic Let's Encrypt wildcard certificates via Cloudflare DNS",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "tunnel-server": "./bin/tunnel-server.js"
  },
  "main": "src/server.js",
  "files": [
    "bin",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arturious9090/webSocket-tunnel.git"
  },
  "keywords": [
    "tunnel",
    "websocket",
    "cloudflare",
    "lets-encrypt",
    "reverse-proxy",
    "ngrok"
  ],
  "scripts": {
    "start": "node bin/tunnel-server.js"
  },
  "dependencies": {
    "@arturious/web-socket-tunnel-protocol": "^1.0.1",
    "acme-client": "^5.4.0",
    "ws": "^8.21.3"
  }
}