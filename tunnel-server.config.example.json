{
  "cloudflare": {
    "apiToken": "YOUR_CLOUDFLARE_API_TOKEN",
    "zoneId": "YOUR_CLOUDFLARE_ZONE_ID",
    "proxy": false
  },
  "domain": "example.com",
  "acme": {
    "email": "admin@example.com",
    "production": true,
    "challengeWaitMs": 5000
  },
  "authToken": "YOUR_SHARED_SECRET_TOKEN",
  "adminToken": "YOUR_ADMIN_TOKEN",
  "authTokens": {
    "CLIENT_TOKEN_1": { "subdomains": ["app"] },
    "CLIENT_TOKEN_2": { "subdomains": ["*"] }
  },
  "rateLimit": {
    "windowMs": 60000,
    "max": 0
  },
  "httpsPort": 443,
  "httpPort": 80,
  "publicIp": null,
  "certsDir": "./certs",
  "requestTimeoutMs": 30000
}