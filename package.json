{
  "name": "web-socket-tunnel",
  "version": "1.0.1",
  "description": "WebSocket HTTP tunnel (Cloudflare Tunnel alternative) with automatic Let's Encrypt wildcard certificates",
  "license": "MIT",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test \"packages/**/test/**/*.test.js\"",
    "backend": "node examples/http_server.js",
    "server": "npm run start --workspace @ws-tunnel/server",
    "client": "npm run start --workspace @ws-tunnel/client"
  }
}