[Unit]
Description=WebSocket Tunnel Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tunnel
Group=tunnel
WorkingDirectory=/opt/ws-tunnel
EnvironmentFile=/etc/ws-tunnel/tunnel-server.env
ExecStart=/usr/bin/node /opt/ws-tunnel/packages/server/bin/tunnel-server.js
Restart=always
RestartSec=5
# Let the process finish graceful shutdown before force-killing.
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target