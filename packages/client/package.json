{
  "name": "@arturious/web-socket-tunnel-client",
  "version": "1.0.1",
  "description": "Local tunnel client that forwards traffic from the public server to a local port",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "tunnel-client": "./bin/tunnel-client.js"
  },
  "main": "src/tunnel.js",
  "files": [
    "bin",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arturious9090/webSocket-tunnel.git"
  },
  "keywords": [
    "tunnel",
    "websocket",
    "reverse-proxy",
    "ngrok",
    "localhost"
  ],
  "scripts": {
    "start": "node bin/tunnel-client.js"
  },
  "dependencies": {
    "@arturious/web-socket-tunnel-protocol": "^1.0.1",
    "ws": "^8.21.3"
  }
}